{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        // `node` is for the test server in tests/ecosystem-client.test.ts —
        // the app itself never touches a node API.
        "types": ["vite/client", "node"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    },
    // `tests` and the vitest config are here so `tsc` covers them too: a test
    // that no longer compiles is a test that stopped guarding anything, and
    // `npm test` alone would report that as a passing suite of whatever is
    // left.
    "include": ["src", "tests", "vitest.config.ts"]
}
